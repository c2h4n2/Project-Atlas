{
  "name": "project-atlas",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "sync-product-images": "tsx scripts/product-images/sync-product-images.ts",
    "sync-product-images:force": "tsx scripts/product-images/sync-product-images.ts --force",
    "sync-products": "tsx scripts/sync-products-v3.ts",
    "sync-products:dry": "tsx scripts/sync-products-v3.ts --dry-run",
    "sync-products:no-images": "tsx scripts/sync-products.ts --skip-images",
    "sync-products:ratings-only": "tsx scripts/sync-products-v3.ts --skip-images --skip-build",
    "collect-ratings:web": "tsx scripts/collect-customer-ratings-web.ts --only-unrated",
    "collect-ratings:web:write": "tsx scripts/collect-customer-ratings-web.ts --only-unrated --write",
    "collect-ratings:web:test": "tsx scripts/collect-customer-ratings-web.ts --only-unrated --limit=3",
    "product-health": "tsx scripts/audit-product-health.ts",
    "images:manifest": "tsx scripts/product-images/generate-upload-manifest.ts",
    "images:import": "tsx scripts/product-images/import-local-images.ts",
    "images:audit": "tsx scripts/product-images/audit-product-images.ts",
    "images:index": "tsx scripts/product-images/index-local-images.ts"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
